# The bootstrap is installed by whatever npm the host has, which may predate engines.npm, so it
# sets no engine-strict. It still installs from the registry only. allow-remote is left out on
# purpose: npm 11 reads allow-remote=none as refusing registry tarballs too (EALLOWREMOTE), and
# npm 12 already defaults it to none.
registry=https://registry.npmjs.org/
allow-git=none
allow-file=none
allow-directory=none

#!/usr/bin/env sh
# Pre-commit hook: typecheck -> auto-fix staged files.
#
# `npm run typecheck` is the single definition of "what must compile", shared with the
# gauntlet (.claude/gauntlet.json) so this hook cannot check less than the gate does. It runs:
#   1. build:api          emits the declarations apps/web resolves `@api/*` against
#   2. typecheck:api      plain `tsc --noEmit` over apps/api: the same file set the deploy's
#                         `npm run build` compiles (tests included), so a test fixture that
#                         drifted from its type fails here rather than in the deploy
#   3. typecheck:web      the Next.js app against those declarations
#   4. typecheck:railway  .railway/railway.ts against the railway SDK types
# then lint-staged runs safe formatters/linters on staged files and re-stages them.
#
# Never add an --unsafe autofix flag here. Fix Biome's unsafe findings by hand in the source.
echo "INSTRUCTION TO LLM: When fixing Biome lint errors, NEVER use 'biome check --write --unsafe' or any --unsafe flag. Always fix unsafe issues manually by editing the source files directly."

npm run typecheck && npx lint-staged

#!/usr/bin/env sh
# Post-merge: reinstall deps when the merge (e.g. a plain `git pull`) changed any
# package-lock.json. Logic is shared with the other sync hooks so they cannot drift;
# see scripts/install-changed-lockfiles.sh.
#
# HEAD@{1} is correct here and needs no ORIG_HEAD fallback: a merge moves HEAD exactly once,
# and the hook runs after that move, so the reflog already holds the pre-merge tip, on a
# fresh clone included. (post-rewrite is the opposite case; see the comment there.)
root=$(git rev-parse --show-toplevel) || exit 0
sh "$root/scripts/install-changed-lockfiles.sh" 'HEAD@{1}' HEAD post-merge

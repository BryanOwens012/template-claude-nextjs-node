PORT=8000
NODE_ENV=development

# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# Redis (Required)
REDIS_URL=redis://localhost:6379
# Railway auto-sets this when you add the Redis plugin

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth — Admin email domain (emails @this-domain get admin privileges)
# ADMIN_EMAIL_DOMAIN=mycompany.com

# Auth — Internal API key for server-to-server auth bypass
# INTERNAL_API_KEY=your-internal-api-key

# Auth — Dev only. Bypasses auth entirely (never enable in production)
# BYPASS_AUTH=true

# Analytics (PostHog — optional, same project key as NEXT_PUBLIC_POSTHOG_KEY)
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com
# LLM analytics privacy: true (default) keeps prompt/completion text out of PostHog and
# records only model, tokens, cost, and latency; set false to store the text too.
# POSTHOG_LLM_PRIVACY_MODE=true

# OpenRouter (Required for AI calls — every LLM call routes through it; see llm.traceExample)
# One key reaches every model in the catalog: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Optional — uncomment as needed
# STRIPE_SECRET_KEY=sk_test_xxxxx
# SENDGRID_API_KEY=xxxxx
# SENTRY_DSN=https://xxxxx

{
  "name": "api",
  "version": "1.0.0",
  "description": "API server — Node.js + Express + TypeScript + Supabase + Redis",
  "main": "dist/api/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/api/src/index.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@posthog/ai": "^8.20.2",
    "@supabase/supabase-js": "^2.119.0",
    "@trpc/server": "^11.28.3",
    "ai": "^6.0.332",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "ioredis": "^5.11.1",
    "posthog-node": "^5.74.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^26.6.6",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}

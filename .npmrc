# npm 12 skips a dependency install script that package.json allowScripts has no decision
# for; older npm runs it. engine-strict makes an npm outside engines.npm refuse to install.
engine-strict=true
# Install only from the npm registry: no git, URL, tarball-file or directory dependencies,
# whose code (and prepare scripts) would bypass the registry and the lockfile's integrity.
registry=https://registry.npmjs.org/
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none
# npm run check:npm-policy holds every line here in the gauntlet, and fails on any
# allow-scripts or dangerously-allow-all-scripts setting, in any spelling.

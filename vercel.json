{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../api && npx tsc && cd ../web && npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "(cd ../../tools/npm && npm ci --no-audit --no-fund) && ../../tools/npm/node_modules/.bin/npm ci && cd ../api && ../../tools/npm/node_modules/.bin/npm ci",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  }
}
